rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (request.auth.token.email == 'ilyasyksel37@gmail.com' || request.auth.uid == 'admin-master');
    }

    // Ürünler & Stok
    match /products/{productId} {
      allow read, write: if true;
    }

    // Ortak Havuz Ürünleri (Global Products Catalog)
    match /global_products/{productId} {
      allow read, write: if true;
    }

    // Envanter / Stok alternatif koleksiyonu
    match /inventory/{itemId} {
      allow read, write: if true;
    }

    // Teklifler & Proforma
    match /quotations/{quoteId} {
      allow read, write: if true;
    }

    // Satışlar (Hızlı Satış, Cari & Fişler)
    match /sales/{saleId} {
      allow read, write: if true;
    }

    // Müşteriler & Cari Hesaplar
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Cari Hesap Ekstresi & Veresiye Hareketleri
    match /customer_transactions/{transId} {
      allow read, write: if true;
    }

    // Tedarikçiler
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // Tedarikçi Hareketleri
    match /supplier_transactions/{transId} {
      allow read, write: if true;
    }

    // Kasa Tanımları
    match /cash_registers/{regId} {
      allow read, write: if true;
    }

    // Kasa Hareketleri
    match /cash_transactions/{transId} {
      allow read, write: if true;
    }

    // Saha Siparişleri
    match /field_orders/{orderId} {
      allow read, write: if true;
    }

    // Giderler
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // Kiracı İşletmeler (Tenants)
    match /tenants/{tenantId} {
      allow read, write: if true;
    }

    // Personel & Kullanıcılar
    match /users/{userId} {
      allow read, write: if true;
    }

    // Ön Yetkilendirme
    match /pre_auth_users/{docId} {
      allow read, write: if true;
    }

    // E-posta Kuyruğu
    match /mail/{mailId} {
      allow read, write: if true;
    }

    // Global catch-all wildcard rule to prevent any permission-denied errors
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
